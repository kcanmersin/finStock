generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Analysis {
  id              String   @id @default(uuid())
  title           String
  type            String
  summary         String
  recommendations String
  rawData         String
  fileName        String
  createdAt       DateTime @default(now())
}
